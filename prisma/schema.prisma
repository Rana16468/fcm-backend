generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  BLOCKED
}

enum QrStatus {
  PENDING
  AUTHORIZED
  EXPIRED
}

model User {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phone        String?
  city         String?
  email        String?
  photo        String?
  status       Status         @default(ACTIVE)
  role         Role           @default(USER)
  os           String?
  browser      String?
  device       String?
  ipAddress    String?
  isOnline     Boolean        @default(false)
  isVerify     Boolean        @default(false)
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  qrSessions   QrSession[]
  suppliers    Suppliers[]
  transactions Transactions[]
  products     Products[]
  invoices     Invoices[]
  expenses     Expenses[]

  @@index([phone, email, status, os, browser, device, isDeleted, isVerify, createdAt])
  @@index([role, city])
  @@index([ipAddress])
  @@index([isDeleted, role])
  @@map("users")
}

model Suppliers {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  companyName  String
  name         String?
  phone        String?
  address      String?
  userId       String         @db.ObjectId
  user         User           @relation(fields: [userId], references: [id])
  products     Products[]
  transactions Transactions[]
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([companyName, phone, address, userId, isDeleted])
  @@map("suppliers")
}

model Products {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  productName     String?
  quantity        Int
  sellingProducts Int?          @default(0)
  price           Float
  totalAmount     Float
  date            DateTime
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id])
  supplierId      String        @db.ObjectId
  supplier        Suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoiceItem     InvoiceItem[]

  @@index([productName, date, supplierId, isDeleted])
  @@map("supplier_products")
}

model Transactions {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  supplierId    String        @db.ObjectId
  supplier      Suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date          DateTime      @default(now())
  type          TrxType
  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  userId        String        @db.ObjectId
  user          User          @relation(fields: [userId], references: [id])
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([supplierId, date, isDeleted])
  @@map("supplier_transactions")
}

enum TrxType {
  PURCHASE
  PAYMENT
  RETURN
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CHEQUE
}

enum InvoicesStatus {
  PAID
  UNPAID
}

model Invoices {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  customerName String?        @default("xxxxx")
  productName  String?        @default("xxxxx")
  phone        String?        @default("xxxxx")
  status       InvoicesStatus
  quentity     Int
  invoiceItems InvoiceItem[]
  date         DateTime       @default(now())
  amount       Int
  userId       String         @db.ObjectId
  user         User           @relation(fields: [userId], references: [id])
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([customerName, phone, status])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @db.ObjectId
  invoice   Invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String @db.ObjectId

  products        Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  productQuantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, productId])
  @@map("invoice_items")
}

enum ExpenseCategory {
  SALARY_AND_WAGES // Employee/Worker salaries, bonuses, overtime
  FACTORY_RENT // Production plant or warehouse rent
  OFFICE_RENT // Corporate or administrative office rent
  UTILITIES // Electricity, gas, water, internet
  MAINTENANCE_AND_REPAIR // Machinery, vehicle, and building maintenance
  TRANSPORTATION // Shipping, freight, fuel, delivery costs
  OFFICE_SUPPLIES // Stationery, daily pantry/refreshment costs
  MARKETING_AND_SALES // Advertisements, promotions, client meetings
  TAXES_AND_FEES // Government taxes, trade licenses, legal fees
  MISCELLANEOUS // Uncategorized daily operational expenses
  Others
}

model Expenses {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  expenseName String?
  amount      Float
  category    ExpenseCategory
  date        DateTime        @default(now())
  userId      String          @db.ObjectId
  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([expenseName, category, date, userId])
  @@map("expenses")
}

model QrSession {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId      String    @unique
  status         QrStatus  @default(PENDING)
  userId         String?   @db.ObjectId
  user           User?     @relation(fields: [userId], references: [id])
  watchTokenHash String?
  expiresAt      DateTime?
  browser        String?
  os             String?
  device         String?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sessionId, status, userId])
  @@map("qr_sessions")
}
