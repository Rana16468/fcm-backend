generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  BLOCKED
}

enum QrStatus {
  PENDING
  AUTHORIZED
  EXPIRED
}

model User {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  phone        String?
  city         String?
  email        String?
  photo        String?
  status       Status         @default(ACTIVE)
  role         Role           @default(USER)
  os           String?
  browser      String?
  device       String?
  ipAddress    String?
  isOnline     Boolean        @default(false)
  isVerify     Boolean        @default(false)
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  qrSessions   QrSession[]
  suppliers    Suppliers[]
  transactions Transactions[]

  @@index([phone, email, status, os, browser, device, isDeleted, isVerify, createdAt])
  @@index([role, city])
  @@index([ipAddress])
  @@index([isDeleted, role])
  @@map("users")
}

model Suppliers {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  companyName  String
  name         String?
  phone        String?
  address      String?
  userId       String         @db.ObjectId
  user         User           @relation(fields: [userId], references: [id])
  products     Products[]
  transactions Transactions[]
isDeleted    Boolean        @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName, phone, address, userId, isDeleted])
  @@map("suppliers")
}

model Products {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  productName String
  quantity    Int
  price       Float
  totalAmount Float
  date        DateTime
  supplierId  String    @db.ObjectId
  supplier    Suppliers @relation(fields: [supplierId], references: [id], onDelete: Cascade)
isDeleted    Boolean        @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productName, date, supplierId, isDeleted])
  @@map("supplier_products")
}

model Transactions {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  supplierId    String        @db.ObjectId
  supplier      Suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date          DateTime      @default(now())
  type          TrxType
  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  userId        String        @db.ObjectId
  user          User          @relation(fields: [userId], references: [id])
  isDeleted    Boolean        @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([supplierId, date, isDeleted])
  @@map("supplier_transactions")
}

enum TrxType {
  PURCHASE
  PAYMENT
  RETURN
  
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CHEQUE
}

model QrSession {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId      String    @unique
  status         QrStatus  @default(PENDING)
  userId         String?   @db.ObjectId
  user           User?     @relation(fields: [userId], references: [id])
  watchTokenHash String?
  expiresAt      DateTime?
  browser        String?
  os             String?
  device         String?
  ipAddress      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sessionId, status, userId])
  @@map("qr_sessions")
}
